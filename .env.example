# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RECIPIENT_EMAIL: Email address that receives confession responses.
RECIPIENT_EMAIL="lamcuongk11@gmail.com"

# Email Delivery (Option 1: Resend API)
RESEND_API_KEY=

# Email Delivery (Option 2: SMTP, e.g. Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=
SMTP_PASS=

# ADMIN_PASSCODE: Passcode for viewing the Creator Inbox inside the app.
ADMIN_PASSCODE=
